{
  "buildCommand": "pnpm run build",
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/:path*", "destination": "/en/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/es/:path*", "destination": "/es/index.html" },
    { "source": "/ru", "destination": "/ru/index.html" },
    { "source": "/ru/:path*", "destination": "/ru/index.html" },
    { "source": "/vi", "destination": "/vi/index.html" },
    { "source": "/vi/:path*", "destination": "/vi/index.html" },
    { "source": "/de", "destination": "/de/index.html" },
    { "source": "/de/:path*", "destination": "/de/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
