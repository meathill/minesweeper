---
import BaseLayout from './BaseLayout.astro';
import type { FaqItem, HowToData } from '../types';

interface Props {
  lang: 'zh' | 'en';
  /** <title> 完整文案 */
  title: string;
  /** 文章 H1 */
  heading: string;
  description: string;
  /** 本语言版本的规范路径（含尾斜杠） */
  path: string;
  keywords?: string;
  updated?: string;
  lede?: string;
  faq?: FaqItem[];
  howTo?: HowToData;
  cta?: { href: string; label: string; text: string };
}

const { lang, heading, updated, lede, faq, cta, ...seo } = Astro.props;
const copy = lang === 'en'
  ? { home: 'Home', faqHeading: 'Frequently asked questions', updated: 'Last updated', playNow: 'Play for free' }
  : { home: '首页', faqHeading: '常见问题', updated: '最后更新', playNow: '免费开始游戏' };
const breadcrumbs = [
  { name: copy.home, path: lang === 'en' ? '/en/' : '/' },
  { name: heading, path: seo.path },
];
const ctaBox = cta ?? (lang === 'en'
  ? { href: '/en/', label: copy.playNow, text: 'Open Meathill Minesweeper and practice what you just learned — Learn Mode shows every cell\'s mine probability.' }
  : { href: '/', label: copy.playNow, text: '打开肉山扫雷练一练：学习模式会实时显示每格是雷的概率，帮你把技巧变成直觉。' });
---

<BaseLayout lang={lang} {...seo} faq={faq} breadcrumbs={breadcrumbs}>
  <div class="mx-auto w-full max-w-3xl px-4">
    <nav aria-label={lang === 'en' ? 'Breadcrumb' : '面包屑'} class="pt-6 text-sm">
      <ol class="flex items-center gap-2">
        <li><a class="underline-offset-2 hover:underline" href={lang === 'en' ? '/en/' : '/'}>{copy.home}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="opacity-70">{heading}</li>
      </ol>
    </nav>
    <article class="prose mt-4 max-w-none">
      <h1>{heading}</h1>
      {lede && <p class="lead">{lede}</p>}
      {updated && <p class="text-sm opacity-60">{copy.updated}：{updated}</p>}
      <slot />
    </article>
    {faq && faq.length > 0 && (
      <section class="prose mt-12 max-w-none" id="faq">
        <h2>{copy.faqHeading}</h2>
        {faq.map((item) => (
          <div>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))}
      </section>
    )}
    <aside class="cta-box mt-12">
      <p>{ctaBox.text}</p>
      <a class="site-nav-cta" href={ctaBox.href}>{ctaBox.label}</a>
    </aside>
  </div>
</BaseLayout>
