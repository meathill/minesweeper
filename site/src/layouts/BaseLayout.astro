---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import type { FaqItem, HowToData } from '../types';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleMeta } from '../i18n';

interface Props {
  lang: string;
  title: string;
  description: string;
  /** 语言中立路径（含尾斜杠），如 '/guide/how-to-play/' */
  path: string;
  keywords?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  faq?: FaqItem[];
  howTo?: HowToData;
  breadcrumbs?: { name: string; path: string }[];
}

const props = Astro.props;
---

<!doctype html>
<html lang={getLocaleMeta(props.lang).htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead {...props} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MEATHILL01" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-MEATHILL01');
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteNav lang={props.lang} path={props.path} />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter lang={props.lang} />
  </body>
</html>
