---
import { brandCatalog, getBrandNetworkLinks } from 'meathill-brand';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const productLinks = getBrandNetworkLinks('minesweeper');
const legalLinks = lang === 'en'
  ? [
    { href: 'https://meathill.com/privacy', label: 'Privacy Policy' },
    { href: 'https://meathill.com/terms', label: 'Terms of Service' },
    { href: 'https://meathill.com/about', label: 'About' },
    { href: 'https://meathill.com/contact', label: 'Contact' },
  ]
  : [
    { href: 'https://meathill.com/privacy', label: '隐私政策' },
    { href: 'https://meathill.com/terms', label: '服务条款' },
    { href: 'https://meathill.com/about', label: '关于我们' },
    { href: 'https://meathill.com/contact', label: '联系方式' },
  ];
const copy = lang === 'en'
  ? { tagline: 'Learn while playing.', allProducts: 'All Products', navLabel: 'Product network' }
  : { tagline: '边玩边学。', allProducts: '全部产品', navLabel: '产品网络' };
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div>
      <a class="site-footer-name" href={brandCatalog.organization.url}>{brandCatalog.organization.name}</a>
      <p>© {new Date().getFullYear()} {brandCatalog.organization.legalName}. {copy.tagline}</p>
      <p class="mt-2">
        {legalLinks.map((link, index) => (
          <>{index > 0 && ' · '}<a href={link.href}>{link.label}</a></>
        ))}
      </p>
    </div>
    <nav aria-label={copy.navLabel} class="site-footer-links">
      {productLinks.map((site) => <a href={site.url}>{site.name}</a>)}
      <a href={brandCatalog.directoryUrl}>{copy.allProducts}</a>
    </nav>
  </div>
</footer>
