    rows: 'Lignes',
    cols: 'Colonnes',
    mines: 'Mines totales',
    reset: 'Réinitialiser',
    flagged: 'Drapeaux',
    remaining: 'Mines restantes',
    trustFlags: 'Compter 🚩 comme mines connues',
    warnExceed: 'Plus de drapeaux que de mines au total — ajustez le nombre.',
    warnContradiction:
      'Grille contradictoire : un chiffre est incompatible avec les drapeaux ou cases voisines.',
    legend:
      'Cliquez sur une case pour faire défiler : cachée → 🚩 → vide (0) → chiffre 1–8 ; clic droit en sens inverse (ou touches 0–8 / F). Le pourcentage indique la probabilité de mine (vert faible → rouge élevé).',
