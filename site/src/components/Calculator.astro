---
// 扫雷概率计算器：静态页面里的原生交互岛，所有多语言文案在组件内渲染，客户端共用同一份脚本
import type { SiteLang } from '../i18n';
import '../styles/calculator.css';

interface Props {
  lang: SiteLang;
}

interface CalculatorCopy {
  difficulty: string;
  easy: string;
  medium: string;
  hard: string;
  custom: string;
  rows: string;
  cols: string;
  mines: string;
  reset: string;
  flagged: string;
  remaining: string;
  trustFlags: string;
  warnExceed: string;
  warnContradiction: string;
  legend: string;
  approx: string;
  labelTemplate: string;
}

const { lang } = Astro.props;
const labels: Record<SiteLang, CalculatorCopy> = {
