const t = labels[lang] ?? labels.en;
---

<div
  class="calc"
  data-calculator
  data-label-template={t.labelTemplate}
  data-warn-exceed={t.warnExceed}
  data-warn-contradiction={t.warnContradiction}
>
  <div class="calc-controls">
    <div class="calc-field">
      <label for="calc-difficulty">{t.difficulty}</label>
      <select
        id="calc-difficulty"
        name="difficulty"
        class="calc-select"
        data-slot="preset"
      >
        <option value="9x9x10" selected>{t.easy}</option>
        <option value="16x16x40">{t.medium}</option>
        <option value="16x30x99">{t.hard}</option>
        <option value="custom">{t.custom}</option>
      </select>
    </div>
    <label class="calc-field" for="calc-rows">
      <span>{t.rows}</span>
      <input
        id="calc-rows"
        name="rows"
        class="calc-input"
        data-slot="rows"
        type="number"
        min="5"
        max="30"
        value="9"
      />
    </label>
    <label class="calc-field" for="calc-cols">
      <span>{t.cols}</span>
      <input
        id="calc-cols"
        name="cols"
        class="calc-input"
        data-slot="cols"
        type="number"
        min="5"
        max="40"
        value="9"
      />
    </label>
    <label class="calc-field" for="calc-mines">
      <span>{t.mines}</span>
      <input
        id="calc-mines"
        name="mines"
        class="calc-input"
        data-slot="mines"
        type="number"
        min="1"
        value="10"
      />
    </label>
    <button type="button" class="calc-btn" data-slot="reset">{t.reset}</button>
  </div>
  <div class="calc-status-bar">
    <p class="calc-status">
      {t.flagged} <b data-slot="flags">0</b> · {t.remaining} <b data-slot="remaining">10</b>
    </p>
    <label class="calc-flag-toggle">
      <input type="checkbox" name="trustFlags" data-slot="trust-flags" checked />
      <span>{t.trustFlags}</span>
    </label>
  </div>
  <p class="calc-warn" data-slot="warn" role="status" aria-live="polite" hidden></p>
  <div class="calc-board" data-slot="board"></div>
  <p class="calc-legend">{t.legend}</p>
  <p class="calc-approx" data-slot="approx" hidden>{t.approx}</p>
</div>

<script>
  import '../scripts/probability-calculator.ts';
</script>
