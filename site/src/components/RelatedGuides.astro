const items = (LINKS[lang] ?? LINKS.en).filter(
  (entry) => entry.path !== currentPath,
);
---

<nav class="related-guides mt-10" aria-label={HEADINGS[lang] ?? HEADINGS.en}>
  <h2 class="related-guides-title">{HEADINGS[lang] ?? HEADINGS.en}</h2>
  <ul class="related-guides-grid">
    {items.map((item) => (
      <li>
        <a class="related-guide-card" href={`${prefix}${item.path}`}>
          <strong>{item.label}</strong>
          <span>{item.desc}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .related-guides-title {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 800;
    color: var(--meathill-ink);
  }

  .related-guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-guide-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    border: 1px solid var(--meathill-rule);
    border-radius: var(--meathill-radius-large);
    background: var(--meathill-paper);
    padding: 12px 14px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .related-guide-card:hover {
    border-color: var(--meathill-yellow-deep);
  }

  .related-guide-card strong {
    color: var(--meathill-yellow-deep);
    font-size: 14px;
    line-height: 1.4;
  }

  .related-guide-card span {
    color: var(--meathill-mute);
    font-size: 12.5px;
    line-height: 1.45;
  }
</style>
