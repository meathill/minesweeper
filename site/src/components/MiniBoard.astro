const t = COPY[lang] ?? COPY.en;
---

<section
  class="mini-board-card not-prose"
  data-mini-board
  data-lang={lang}
  data-path={path}
  data-cell-label={t.cellLabel}
  data-dig-label={t.digLabel}
  data-flag-label={t.flagLabel}
  data-win-text={t.winText}
  data-lose-text={t.loseText}
  aria-label={t.badge}
>
  <div class="mb-header">
    <p class="mb-badge">{t.badge}</p>
    <a class="mb-full-cta" data-mb-slot="full-link" href={fullGameHref}>
      {t.fullModeLabel}
    </a>
  </div>

  <div class="mb-stage">
    <div class="mb-toolbar">
      <span class="mb-stat" aria-live="polite">
        💣 <strong data-mb-slot="mines">10</strong>
      </span>
      <button
        type="button"
        class="mb-mode-btn"
        data-mb-slot="mode"
        aria-pressed="false"
        aria-label={t.modeAria}
      >
        {t.digLabel}
      </button>
      <button
        type="button"
        class="mb-reset-btn"
        data-mb-slot="reset"
        aria-label={t.resetAria}
        title={t.resetAria}
      >
        😊
      </button>
      <span class="mb-stat mb-timer" data-mb-slot="timer">0:00</span>
    </div>

    <div class="mb-grid" data-mb-slot="grid" role="grid"></div>
  </div>

  <div class="mb-banner" data-mb-slot="banner" hidden>
    <span data-mb-slot="banner-text"></span>
    <a class="mb-banner-link" data-mb-slot="full-link" href={fullGameHref}>
      {t.fullModeLabel}
    </a>
  </div>

  <p class="mb-hint">{t.hint}</p>
</section>

<script>
  import '../scripts/mini-board';
</script>
