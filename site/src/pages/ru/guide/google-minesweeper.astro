---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import type { FaqItem, HowToData } from '../../../types';

const faq: FaqItem[] = [
  {
    question: 'Как открыть Сапёр от Google?',
    answer:
      'Введите «сапёр» или «minesweeper» в поиске Google — играбельное поле появится прямо над результатами. Без приложения, без установки и без аккаунта.',
  },
  {
    question: 'Как ставить флажки в Сапёре от Google?',
    answer:
      'Правый щелчок по клетке на компьютере; долгое нажатие на телефоне или планшете. Флажки отмечают клетки, где вы уверены в мине.',
  },
  {
    question: 'Сапёр от Google бесплатный?',
    answer:
      'Да, полностью бесплатный. Это встроенный пасхальный секрет Google, вход куда-либо не нужен.',
  },
  {
    question: 'Чем он отличается от классического Сапёра?',
    answer:
      'Правила идентичны классике. Разница — по краям: нет подсказок по вероятностям, нет повтора партии, статистика не сохраняется между устройствами.',
  },
  {
    question: 'Можно ли играть с телефона?',
    answer:
      'Да — найдите «сапёр» в мобильном браузере и играйте прямо в результатах; долгое нажатие ставит флажок. Если сенсорное управление неудобно, версия без правой кнопки вроде Meathill Minesweeper на телефоне играется лучше.',
  },
];

const howTo: HowToData = {
  name: 'Как открыть и играть в Сапёра от Google',
  steps: [
    'Введите «сапёр» в поиске Google — играбельное поле появится над результатами.',
    'Выберите сложность и щёлкните любую клетку — первый щелчок безопасен.',
    'Читайте цифры: каждая считает мины в 8 соседних клетках.',
    'Правый щелчок или долгое нажатие — флажок; откройте все безопасные клетки, чтобы победить.',
  ],
};
---

<GuideLayout
  lang="ru"
  title="Сапёр от Google: как открыть, ставить флажки и играть - Meathill Minesweeper"
  heading="Сапёр от Google: как играть"
  description="Всё о Сапёре от Google: как открыть его из поиска, как ставить флажки правым щелчком и долгим нажатием, что значат цифры и чего не хватает тем, кто хочет расти."
  path="/guide/google-minesweeper/"
  keywords="сапёр от google, google сапёр, как играть в сапёра от google, сапёр онлайн google"
  updated="2026-09-03"
  lede="Сапёр от Google — это пасхалка внутри поиска: введите «сапёр», и над результатами появится играбельное поле с правилами классического Сапёра. Здесь — как его открыть, как работают жесты и когда стоит перейти на более полную версию."
  faq={faq}
  howTo={howTo}
>
  <h2>Как открыть Сапёр от Google?</h2>
  <p>
    Самый быстрый способ: <strong>введите «сапёр» в поиске Google</strong>. Играбельное поле встроено прямо над результатами —
    щёлкните и играйте. Это пасхалка из серии Doodles: ничего устанавливать и где-либо регистрироваться не нужно.
  </p>

  <h2>Правила</h2>
  <p>Идентичны классическому Сапёру:</p>
  <ul>
    <li><strong>Цифры</strong>: открытая клетка считает мины в 8 клетках вокруг.</li>
    <li><strong>Флажки</strong>: отмечайте известные мины, чтобы не щёлкнуть по ошибке.</li>
    <li><strong>Безопасный первый щелчок</strong>: как почти во всех современных версиях, первый щелчок никогда не попадает на мину.</li>
    <li><strong>Победа</strong>: откройте все клетки без мин; таймер засекает время.</li>
  </ul>

  <h2>Как ставить флажки?</h2>
  <p>
    <strong>Правый щелчок на компьютере</strong>; <strong>долгое нажатие на телефоне или планшете</strong>. Флажки важны не
    только против ошибок: когда флажков вокруг цифры столько же, сколько сама цифра, все оставшиеся соседи гарантированно безопасны.
  </p>
  <p>
    Такое открытие цепочкой в большинстве версий запускается двойным щелчком. Где жеста нет, середина игры превращается в
    медленное открытие по одной клетке — одна из главных причин, почему игроки уходят на специализированные сайты.
  </p>

  <h2>Игра без мыши (пользователи тачпада)</h2>
  <p>
    На ноутбуке «правый щелчок» — это обычно щелчок двумя пальцами, а «зажать обе кнопки» — сущее мучение. Два пути:
  </p>
  <ol>
    <li>Смириться с системными жестами: щелчок двумя пальцами вместо правого, расплачиваясь скоростью.</li>
    <li>Перейти на версию, созданную под тачпад: <a href="/">Meathill Minesweeper</a> обходится без правой кнопки — когда
      флажки совпадают с цифрой, двойной щелчок открывает остальное; настроено под однокнопочную мышь Apple, тачпад Mac и телефон.</li>
  </ol>

  <h2>Где он не дотягивает: играть весело, учиться — нет</h2>
  <p>Как развлечение — отлично. Для тех, кто хочет расти, три боли:</p>
  <ul>
    <li>Нет <strong>подсказок по вероятностям</strong>: моменты «орёл или решка» остаются лотереей, и вы никогда не узнаете, насколько близок был выбор.</li>
    <li>Нет <strong>повтора</strong>: проигрыш — это просто конец; к точке перелома не вернуться.</li>
    <li>Нет <strong>статистики</strong>: время и победы не сохраняются между устройствами — прогресс не видно.</li>
  </ul>
  <p>
    Если это важно, сыграйте партию в <a href="/">Meathill Minesweeper</a>: режим обучения накладывает живую карту вероятностей,
    оценивает каждое решение, а повтор рисует эффективность и вероятность мины в реальные моменты щелчков — превращая угадывание в расчёт.
  </p>
</GuideLayout>
