---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import type { FaqItem, HowToData } from '../../../types';

const faq: FaqItem[] = [
  {
    question: 'Может ли первый щелчок попасть на мину?',
    answer:
      'В классической случайной расстановке — мог бы, но практически все современные реализации защищают первый щелчок. Meathill Minesweeper идёт дальше: первый щелчок всегда открывает пустую клетку, а область 3×3 вокруг остаётся без мин.',
  },
  {
    question: 'Что означают цифры в Сапёре?',
    answer:
      'Каждая цифра считает мины в 8 соседних клетках. «1» — ровно одна мина рядом, «3» — три, и так далее.',
  },
  {
    question: 'Как играть без мыши? Как ставить флажки на телефоне?',
    answer:
      'На сенсорном экране удерживайте клетку, чтобы поставить флажок. В Meathill Minesweeper правая кнопка мыши вообще не нужна: когда флажков столько же, сколько цифра, двойной щелчок открывает всё остальное — удобно на тачпаде и телефоне.',
  },
  {
    question: 'Сапёр — это игра на удачу?',
    answer:
      'Нет. Почти любое поле решается логикой на пересечении цифр; лишь редкие концевые позиции заставляют угадывать. Режим обучения в Meathill Minesweeper показывает вероятность мины в каждой клетке в реальном времени.',
  },
  {
    question: 'Что такое «чординг» (открытие цепочкой)?',
    answer:
      'Когда количество флажков вокруг открытой цифры равно самой цифре, двойной щелчок по ней открывает все оставшиеся соседние клетки сразу. Это ключевой приём быстрой игры.',
  },
];

const howTo: HowToData = {
  name: 'Как играть в Сапёра',
  steps: [
    'Начните игру и щёлкните любую клетку — первый щелчок всегда безопасен.',
    'Читайте цифры: каждая считает мины в 8 соседних клетках.',
    'Правый щелчок или долгое нажатие — флажок; когда флажков столько же, сколько цифра, двойной щелчок открывает остальных соседей.',
    'Откройте все безопасные клетки, чтобы победить. Застряли — включите режим обучения и смотрите вероятность для каждой клетки.',
  ],
};
---

<GuideLayout
  lang="ru"
  title="Как играть в Сапёра: правила, советы и гайд для новичков - Meathill Minesweeper"
  heading="Как играть в Сапёра"
  description="Полное руководство по Сапёру: что означают цифры, как ставить флажки, чординг, типичные ошибки новичков и паттерн 1-2-1 — плюс ответы на самые частые вопросы."
  path="/guide/how-to-play/"
  keywords="сапёр как играть, сапёр правила, игра сапёр, сапёр для новичков, сапёр советы"
  updated="2026-09-03"
  lede="Цель Сапёра — открыть все безопасные клетки, не подорвавшись: каждая цифра говорит, сколько мин вокруг. Отметьте все мины, откройте остальные — и победа. Вот всё, что нужно, чтобы от первой партии перейти к стабильным выигрышам."
  faq={faq}
  howTo={howTo}
>
  <h2>В чём цель Сапёра?</h2>
  <p>
    На поле спрятаны мины; все остальные клетки безопасны. Ваша задача — <strong>открыть все безопасные клетки</strong>:
    наступили на мину — поражение, открыли всё остальное — победа. Сапёр — это логическая головоломка, где каждая цифра — подсказка, а не удача.
  </p>

  <h2>Правила Сапёра</h2>
  <ul>
    <li><strong>Цифры</strong>: открытая клетка считает мины в 8 клетках вокруг. «1» — одна соседняя мина, «3» — три.</li>
    <li><strong>Флажки</strong>: отмечайте клетки, где точно мина, чтобы не щёлкнуть по ошибке.</li>
    <li><strong>Безопасный первый щелчок</strong>: современные версии защищают первый ход; Meathill Minesweeper гарантирует пустое открытие и зону 3×3 без мин.</li>
    <li><strong>Победа</strong>: откройте все клетки без мин; мина — мгновенное поражение.</li>
  </ul>

  <h2>Базовые действия: открыть, отметить, открыть цепочкой</h2>
  <p>Три действия на всю партию:</p>
  <ol>
    <li><strong>Открыть</strong>: левый щелчок по закрытой клетке. Цифры появляются сразу; пустые области раскрываются каскадом.</li>
    <li><strong>Отметить</strong>: правый щелчок (или долгое нажатие на телефоне) ставит флажок на подозрительную мину.</li>
    <li><strong>Чординг</strong>: когда флажков вокруг цифры столько же, сколько сама цифра, двойной щелчок открывает всех остальных соседей — главный приём скорости.</li>
  </ol>
  <p>
    Пользователи тачпадов и мышей Apple часто бросают из-за «зажать обе кнопки» — <a href="/">Meathill Minesweeper</a>
    вообще отказался от правой кнопки: когда флажки совпадают с цифрой, двойной щелчок открывает остальное — одинаково удобно на тачпаде и телефоне.
  </p>

  <h2>Три ошибки новичка</h2>
  <ol>
    <li><strong>Читать цифры поодиночке</strong>: игра живёт на пересечениях. Ищите клетки, где цифра равна числу закрытых соседей (все — мины), и цифры, уже «закрытые» флажками (соседей можно открывать).</li>
    <li><strong>Ставить флажки наугад</strong>: неуверенные флажки отравляют собственные подсказки. Отмечайте только 100% клетки.</li>
    <li><strong>Долго думать на 50/50</strong>: некоторые концевые позиции — чистое угадывание. Выбирайте клетку с лучшей вероятностью и идите дальше — сомнения дороже риска.</li>
  </ol>

  <h2>Дальше: от дедукции к вероятностям</h2>
  <p>Два классических паттерна сразу поднимают процент побед:</p>
  <ul>
    <li><strong>«1-1»</strong>: две соседние единицы с общими закрытыми клетками — всё за пределами их общей зоны безопасно.</li>
    <li><strong>«1-2-1»</strong>: горизонтальный ряд 1-2-1 — внешние углы единиц это мины, оставшиеся соседи двойки безопасны.</li>
  </ul>
  <p>
    Когда паттерны заканчиваются, играет вероятность — и интуиция здесь ошибается на удивление часто: две «похожие» клетки могут
    быть 30% и 70%. <a href="/">Режим обучения в Meathill Minesweeper</a> накладывает на поле живую карту вероятностей, превращая
    каждый щелчок в решение, которое можно сравнить, разобрать и улучшить.
  </p>
</GuideLayout>
