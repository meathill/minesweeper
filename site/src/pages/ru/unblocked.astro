---
import GuideLayout from '../../layouts/GuideLayout.astro';
import type { FaqItem } from '../../types';

const faq: FaqItem[] = [
  {
    question: 'Нужно ли что-то скачивать?',
    answer:
      'Нет. Эта страница и есть игра: откройте в браузере и играйте — без установки, без аккаунта и без расширений.',
  },
  {
    question: 'Что делать, если связь оборвалась посреди партии?',
    answer:
      'После загрузки страницы игра работает полностью на вашем устройстве. Короткий обрыв не влияет на текущую партию; обновление страницы начнёт новую.',
  },
  {
    question: 'Как ставить флажки на телефоне?',
    answer:
      'Долгое нажатие на клетке ставит флажок. Когда флажков столько же, сколько цифра, двойной щелчок открывает остальных соседей — правая кнопка не нужна нигде.',
  },
  {
    question: 'Как играть на весь экран?',
    answer:
      'Нажмите кнопку «Открыть на весь экран», чтобы играть в новой вкладке, или F11 в браузере на компьютере для полноэкранного режима.',
  },
];
---

<GuideLayout
  lang="ru"
  title="Сапёр онлайн - играть бесплатно, без скачивания - Meathill Minesweeper"
  heading="Сапёр онлайн — играйте без скачивания"
  description="Играйте в Сапёра прямо в браузере: без установки и регистрации, без всплывающих окон. Долгое нажатие — флажок, без правой кнопки, три сложности и режим обучения. Поле прямо на этой странице."
  path="/unblocked/"
  keywords="сапёр онлайн, играть в сапёра, сапёр бесплатно, сапёр без скачивания, сапёр в браузере"
  updated="2026-09-03"
  lede="Это Сапёр прямо в браузере: ничего скачивать, нигде регистрироваться, поле прямо ниже — щёлкните и играйте."
  faq={faq}
  cta={{ href: '/en/', label: 'Открыть на весь экран', text: 'Нужно поле побольше и полный опыт? Откройте игру в новой вкладке.' }}
>
  <h2>Сапёр онлайн — ноль настройки</h2>
  <ul>
    <li><strong>Без скачивания и установки</strong>: обычная веб-страница, которая и есть полная игра; на устройство ничего не записывается.</li>
    <li><strong>Без всплывающих окон</strong>: никаких баннеров и попапов; после загрузки всё работает локально и без задержек.</li>
    <li><strong>Дружелюбно к сенсорным экранам</strong>: долгое нажатие — флажок, двойной щелчок — открытие цепочкой; правая кнопка не нужна нигде.</li>
    <li><strong>Хотите расти?</strong> Встроенный режим обучения: живая карта вероятностей, оценка каждого решения и полный повтор партии.</li>
  </ul>

  <h2>Играть в Сапёра онлайн</h2>
  <iframe
    class="play-iframe"
    src="/en/"
    title="Meathill Minesweeper - онлайн Сапёр"
  ></iframe>
  <p class="text-sm opacity-60">Это и есть игра: левый щелчок — открыть, правый щелчок или долгое нажатие — флажок, двойной щелчок по цифре — открытие цепочкой.</p>

  <h2>С каких сетей доступно?</h2>
  <p>
    Это обычный HTTPS-сайт, он открывается из домашних и типичных офисных сетей. Если сеть школы или компании явно ограничивает
    игровые сайты, соблюдайте правила этой сети; совсем без интернета подойдёт Сапёр, встроенный в вашу операционную систему.
  </p>
</GuideLayout>
<style>
  .play-iframe {
    display: block;
    width: 100%;
    height: clamp(480px, 72vh, 760px);
    border: 1px solid var(--meathill-rule-strong);
    border-radius: var(--meathill-radius-large);
    background: var(--meathill-paper);
  }
</style>
