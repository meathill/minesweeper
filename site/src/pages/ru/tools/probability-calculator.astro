---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import Calculator from '../../../components/Calculator.astro';
import type { FaqItem } from '../../../types';

const faq: FaqItem[] = [
  {
    question: 'Насколько точен калькулятор вероятностей?',
    answer:
      'Клетки фронтона (закрытые рядом с цифрами) считаются точным перебором всех допустимых расстановок мин — это настоящие математические вероятности. Изолированные клетки делят оставшиеся мины поровну. Очень большие компоненты переходят к поиску гарантированных мин/безопасных клеток плюс приближение, и страница об этом сообщает.',
  },
  {
    question: 'Чем это отличается от режима обучения в игре?',
    answer:
      'Режим обучения обновляется прямо во время партии, оценивает каждое решение и поддерживает повтор после игры. Калькулятор — статический анализ любого поля: разобрать своё поражение или изучить чужую позицию. Движок один и тот же.',
  },
  {
    question: 'Какие размеры поля поддерживаются?',
    answer:
      'Три пресета (Лёгкий 9×9·10, Средний 16×16·40, Сложный 16×30·99) плюс свои строки, столбцы и число мин. Компоненты больше 28 клеток переключаются на приближение ради скорости.',
  },
  {
    question: 'Влияют ли флажки на расчёт?',
    answer:
      'Да, по умолчанию флажки 🚩 считаются подтверждёнными минами и вычитаются из соседних цифр и остатка мин. Если вы сомневаетесь в своих флажках, снимите галочку «Считать 🚩 известными минами» — решатель проигнорирует их и покажет реальную вероятность рядом с каждым флажком.',
  },
];
---

<GuideLayout
  lang="ru"
  title="Калькулятор вероятностей в Сапёре - точная вероятность для каждой клетки - Meathill Minesweeper"
  heading="Калькулятор вероятностей в Сапёре"
  description="Бесплатный онлайн-калькулятор вероятностей для Сапёра: восстановите любую позицию и получите точную вероятность мины в каждой закрытой клетке. Тот же движок, что и режим обучения в Meathill Minesweeper."
  path="/tools/probability-calculator/"
  keywords="калькулятор вероятностей сапёр, сапёр вероятности, решатель сапёра, сапёр калькулятор онлайн"
  updated="2026-10-30"
  lede="Восстановите увиденную позицию — отмечайте флажки 🚩, пустые клетки (0) и цифры 1–8 — и калькулятор вычислит точную вероятность мины для каждой закрытой клетки."
  faq={faq}
>
  <Calculator lang="ru" />

  <h2>Как пользоваться калькулятором</h2>
  <ol>
    <li>Выберите сложность в выпадающем списке или задайте свои строки, столбцы и число мин.</li>
    <li><strong>Щёлкайте по клеткам, чтобы менять состояние</strong>: закрыта → 🚩 → пусто (0) → цифра 1–8; правый щелчок — назад (или клавиши <code>0–8</code> / <code>F</code>).</li>
    <li>Каждая закрытая клетка показывает вероятность мины (%), зелёный низкий → красный высокий. Снимите галочку «Считать 🚩 известными минами», если хотите проверить сомнительные флажки.</li>
    <li>Застряли? Играйте наименьший процент — это ход с лучшим матожиданием.</li>
  </ol>

  <h2>Как считаются вероятности</h2>
  <p>
    Каждая открытая клетка (включая пустую <code>0</code>) задаёт точное ограничение на закрытых соседей с учётом подтверждённых флажков. Решатель делит связанные
    ограничения на независимые компоненты и <strong>точно перебирает каждую с отсечениями</strong>, считая, сколько раз клетка
    оказывается миной среди всех допустимых расстановок; изолированные клетки делят оставшиеся мины поровну. Компоненты больше
    28 клеток переходят к поиску гарантированных мин/безопасных клеток плюс приближение — с пометкой на странице.
  </p>

  <h2>Когда это полезно</h2>
  <ul>
    <li><strong>Моменты «орёл или решка»</strong>: интуиция говорит «примерно равно», цифры — 30% против 70%.</li>
    <li><strong>Разбор поражений</strong>: восстановите проигранную позицию и проверьте, был ли тот щелчок верным.</li>
    <li><strong>Тренировка интуиции</strong>: сверяйте своё чутьё с картой вероятностей, пока они не совпадут.</li>
  </ul>
</GuideLayout>
