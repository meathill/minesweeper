---
import GuideLayout from '../../layouts/GuideLayout.astro';
import type { FaqItem, HowToData } from '../../types';

const faq: FaqItem[] = [
  {
    question: '扫雷第一下会不会点到雷？',
    answer:
      '经典随机布雷的版本有可能，但几乎所有现代实现都会保护首击。肉山扫雷更进一步：第一次点击必定是空白格，并以点击处为中心的 3×3 范围禁雷，开局总能展开一片区域。',
  },
  {
    question: '扫雷上的数字是什么意思？',
    answer:
      '数字表示以它为中心的周围 8 格中一共有多少颗地雷。「1」代表旁边恰好有 1 颗雷，「3」代表旁边有 3 颗，以此类推。',
  },
  {
    question: '没有鼠标怎么玩扫雷？手机上怎么插旗？',
    answer:
      '触屏上长按即可插旗。肉山扫雷还支持免右键玩法：当旗数与数字一致时，双击数字即可批量打开其余邻格，触摸板和手机都很顺手。',
  },
  {
    question: '扫雷是不是靠猜？',
    answer:
      '不是。绝大多数局面都能通过数字之间的逻辑关系推出安全格，只有极少数残局才需要按概率权衡。肉山扫雷的学习模式会实时显示每格是雷的概率，帮你看清哪些是推理、哪些是猜测。',
  },
  {
    question: '双击连开（chording）是什么？',
    answer:
      '当某个数字周围已插的旗数正好等于该数字时，双击这个数字可以一次性翻开其余所有邻格。它是扫雷提速的关键操作，也是高级玩家成绩的分水岭。',
  },
];

const howTo: HowToData = {
  name: '怎么玩扫雷',
  steps: [
    '打开一局扫雷，点击任意格子翻开第一格（首击必定安全）。',
    '看数字推理：数字表示周围 8 格中的地雷总数，据此找出必定是雷的格子。',
    '右键或长按插旗标记地雷；旗数等于数字时，双击数字即可批量打开其余邻格。',
    '翻开所有非雷格子即获胜；卡住时可以开启学习模式，查看每格是雷的概率热力图。',
  ],
};
---

<GuideLayout
  lang="zh"
  title="扫雷怎么玩？规则、技巧与新手指南 - 肉山扫雷"
  heading="扫雷怎么玩？"
  description="一篇讲透扫雷的教程：数字含义、插旗与双击连开、新手常见误区、1-2-1 定式与概率思维，并附新手最常问的 FAQ。学习模式可实时显示每格地雷概率。"
  path="/guide/how-to-play/"
  keywords="扫雷怎么玩,扫雷规则,扫雷技巧,扫雷数字含义,扫雷教学,双击连开"
  updated="2026-09-02"
  lede="扫雷的目标是在不点中地雷的前提下翻开所有安全格：数字表示周围 8 格中的地雷数量，标出全部地雷、翻开其余格子即获胜。从零基础到稳定通关，掌握下面这些内容就够了。"
  faq={faq}
  howTo={howTo}
>
  <h2>扫雷的目标是什么？</h2>
  <p>
    棋盘上埋着若干地雷，其余格子都是安全的。你要做的是<strong>翻开所有安全格</strong>：点中地雷立刻失败，全部翻开即胜利。
    扫雷本质上是一道不断推进的逻辑题——每一个数字都是线索，而不是碰运气的赌博。
  </p>

  <h2>扫雷的规则是什么？</h2>
  <ul>
    <li><strong>数字的含义</strong>：翻开的数字表示以它为中心的周围 8 格中共有多少颗地雷。「1」表示旁边恰有 1 颗雷，「3」表示旁边有 3 颗。</li>
    <li><strong>插旗标记</strong>：确定某格是雷后可以插旗，防止误点，也方便统计剩余雷数。</li>
    <li><strong>首次点击安全</strong>：主流扫雷都会保护第一次点击；肉山扫雷保证首击必为空白格，并在 3×3 范围内禁雷。</li>
    <li><strong>胜负条件</strong>：翻开所有非雷格子即获胜；点中地雷立即失败。</li>
  </ul>

  <h2>基本操作：翻开、插旗和双击连开</h2>
  <p>三个动作贯穿全局：</p>
  <ol>
    <li><strong>左键翻开</strong>：点击未翻开的格子。数字直接显示；空白格会自动展开连成一片。</li>
    <li><strong>右键或长按插旗</strong>：标记你认为有雷的格子，手机上长按即可。</li>
    <li><strong>双击连开（chording）</strong>：某数字周围已插旗数等于数字本身时，双击该数字一次性翻开其余邻格，是提速的核心。</li>
  </ol>
  <p>
    用 Apple 鼠标或触摸板的玩家常被「左右键同按」劝退——<a href="/">肉山扫雷</a>干脆免掉了右键：旗数与数字一致时双击数字即可批量打开，触摸板和手机同样顺手。
  </p>

  <h2>新手最常犯的三个错误</h2>
  <ol>
    <li><strong>只看单个数字</strong>：关键在数字之间的组合关系。先找「数字 == 周围未翻开格数」的必雷格，再找「数字 == 周围已插旗数」的可连开格。</li>
    <li><strong>过早插旗</strong>：没把握的旗会污染线索。旗只该插在 100% 确定的格子上。</li>
    <li><strong>在两难处犹豫太久</strong>：少数局面确实只剩猜测，此时按概率果断选更优一格，比反复琢磨更划算。</li>
  </ol>

  <h2>进阶技巧：从确定推理到概率判断</h2>
  <p>两个经典定式能立刻提升胜率：</p>
  <ul>
    <li><strong>「1-1」</strong>：两个相邻的 1 共享同一批未翻开格时，交集之外的格子必然安全。</li>
    <li><strong>「1-2-1」</strong>：横向的 1、2、1，两侧 1 的顶角必是雷，中间 2 的剩余格必然安全。</li>
  </ul>
  <p>
    定式覆盖不到的局面就要按概率权衡，而直觉在这里很容易出错——两个「看起来」差不多的候选格，实际可能是 30% 与 70% 的差别。
    <a href="/">肉山扫雷的学习模式</a>会在棋盘上实时叠加每格是雷的概率热力图，把每次点击变成可对照、可复盘的决策。
  </p>
</GuideLayout>
