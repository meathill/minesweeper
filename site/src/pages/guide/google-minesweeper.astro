---
import GuideLayout from '../../layouts/GuideLayout.astro';
import type { FaqItem, HowToData } from '../../types';

const faq: FaqItem[] = [
  {
    question: '谷歌扫雷怎么打开？',
    answer:
      '在 Google 搜索框输入 minesweeper 或「扫雷」，搜索结果最上方会直接出现一个可以玩的扫雷小游戏，点开即玩，无需安装任何东西。',
  },
  {
    question: '谷歌扫雷怎么插旗？',
    answer:
      '电脑上用鼠标右键点击格子插旗；手机和平板上长按格子插旗。插旗用来标记你确定有雷的格子，防止误点。',
  },
  {
    question: '谷歌扫雷免费吗？要登录吗？',
    answer:
      '免费，也不需要登录任何账号。它是 Google 内置的彩蛋小游戏，打开搜索页就能玩。',
  },
  {
    question: '谷歌扫雷和经典扫雷有什么区别？',
    answer:
      '规则和经典扫雷完全一致，差别主要在外围功能：谷歌版没有概率提示、没有对局复盘，成绩也不会跨设备保存。想系统提升的玩家，更适合带学习功能的扫雷版本。',
  },
  {
    question: '手机上能玩谷歌扫雷吗？',
    answer:
      '可以。在手机浏览器里搜索 minesweeper 就能玩，长按即可插旗。如果觉得触屏操作不顺手，可以试试免右键设计的肉山扫雷。',
  },
];

const howTo: HowToData = {
  name: '怎么打开并玩谷歌扫雷',
  steps: [
    '在 Google 搜索框输入 minesweeper 或「扫雷」，搜索结果顶部会出现可直接玩的扫雷。',
    '选择难度，左键点击格子翻开第一格（首击通常安全）。',
    '根据数字推理地雷位置：数字表示周围 8 格中的地雷数量。',
    '右键或长按插旗标记地雷；翻开所有非雷格子即获胜。',
  ],
};
---

<GuideLayout
  lang="zh"
  title="谷歌扫雷怎么玩？打开方式、插旗与规则详解 - 肉山扫雷"
  heading="谷歌扫雷怎么玩？"
  description="谷歌扫雷（Google Minesweeper）完全攻略：怎么在搜索页打开、电脑右键和手机长按怎么插旗、数字规则怎么理解，以及它和经典扫雷的区别与替代选择。"
  path="/guide/google-minesweeper/"
  keywords="谷歌扫雷,google扫雷,谷歌扫雷怎么玩,谷歌扫雷插旗,google minesweeper"
  updated="2026-09-03"
  lede="谷歌扫雷是 Google 内置在搜索页里的彩蛋小游戏：搜索「minesweeper」或「扫雷」即可直接玩，规则与经典扫雷一致。本文讲清打开方式、插旗手势和数字规则，也说说它的局限和更适合练手的替代。"
  faq={faq}
  howTo={howTo}
>
  <h2>怎么打开谷歌扫雷？</h2>
  <p>
    最快的方式：<strong>在 Google 搜索框输入 minesweeper 或「扫雷」</strong>，搜索结果最上方会内嵌一个可以直接玩的扫雷棋盘，点击即开。
    它来自 Google 的彩蛋/Doodle 系列，不需要下载 App，也不需要登录。
  </p>

  <h2>谷歌扫雷的规则是什么？</h2>
  <p>规则与经典扫雷完全相同：</p>
  <ul>
    <li><strong>数字的含义</strong>：翻开的数字表示以它为中心的周围 8 格中共有多少颗地雷。</li>
    <li><strong>插旗</strong>：确定某格是雷后插旗标记，防止误点。</li>
    <li><strong>首击安全</strong>：和大多数现代实现一样，第一次点击不会踩雷。</li>
    <li><strong>胜负</strong>：翻开所有非雷格子获胜，点中地雷即失败，页面会显示用时。</li>
  </ul>

  <h2>谷歌扫雷怎么插旗？</h2>
  <p>
    <strong>电脑上右键点击格子</strong>即可插旗；<strong>手机和平板上长按格子</strong>插旗。
    插旗的意义除了防误点，还在于配合连开：当某个数字周围已插旗数等于数字时，该数字的其余邻格必然安全。
  </p>
  <p>
    连开（chording）在不少扫雷实现里用双击触发。如果某个版本没有提供这个手势，中后期逐格点开会明显变慢——这也是很多玩家最后转向专门扫雷网站的原因之一。
  </p>

  <h2>没有鼠标怎么玩？触摸板用户怎么办？</h2>
  <p>
    笔记本触摸板「右键」通常要双指点击，「左右键同按」的连开更是反人类。两条路：
  </p>
  <ol>
    <li>用系统手势硬凑：双指轻点模拟右键，牺牲速度换取可玩。</li>
    <li>换一个为触摸板设计的版本：<a href="/">肉山扫雷</a>干脆免掉右键——旗数与数字一致时，双击数字即可批量打开剩余邻格，Apple Magic Mouse 单键、Mac 触摸板和手机都顺手。</li>
  </ol>

  <h2>谷歌扫雷的局限：玩可以，学不够</h2>
  <p>
    谷歌扫雷作为消遣非常合格，但对想提升水平的玩家有几个硬伤：
  </p>
  <ul>
    <li>没有<strong>概率提示</strong>：两难局面只能凭感觉猜，猜错也不知道当时的选择差多少。</li>
    <li>没有<strong>复盘</strong>：败局即结束，无法回看哪一步是转折点。</li>
    <li>没有<strong>成绩沉淀</strong>：用时和胜率不跨设备保存，进步不可量化。</li>
  </ul>
  <p>
    如果你在意这些，可以在<a href="/">肉山扫雷</a>里开一局：学习模式实时叠加每格地雷概率热力图、给每次决策打分，局后还有按真实时刻打点的四线复盘图——把「猜」变成「算」。
  </p>
</GuideLayout>
