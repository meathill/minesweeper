---
import GuideLayout from '../../layouts/GuideLayout.astro';
import type { FaqItem } from '../../types';

const faq: FaqItem[] = [
  {
    question: 'Preciso baixar algum programa para jogar?',
    answer:
      'Não. O jogo completo roda direto nesta página do navegador — sem download, sem cadastro e sem plugins.',
  },
  {
    question: 'E se a internet cair no meio da partida?',
    answer:
      'Assim que a página carrega, toda a lógica roda localmente no seu aparelho. Uma oscilação de rede não interrompe sua partida atual.',
  },
  {
    question: 'Como colocar bandeira no celular ou notebook?',
    answer:
      'Segure o dedo sobre a casa no celular ou use dois dedos no trackpad. Quando as bandeiras igualam um número, dê duplo clique nele para abrir as vizinhas seguras.',
  },
  {
    question: 'Como jogar em tela cheia?',
    answer:
      'Clique em «Abrir em tela cheia» abaixo para ir ao tabuleiro dedicado ou pressione F11 no navegador do computador.',
  },
];
---

<GuideLayout
  lang="pt"
  title="Campo Minado Online Grátis - Jogar no Navegador Sem Baixar - Meathill Minesweeper"
  heading="Campo Minado Online — jogue na hora"
  description="Jogue Campo Minado grátis direto no navegador: sem download, sem cadastro, otimizado para trackpad e celular, com três dificuldades e Modo Aprendizado."
  path="/unblocked/"
  keywords="campo minado online, jogar campo minado grátis, campo minado navegador, campo minado sem baixar, campo minado desbloqueado"
  updated="2026-10-30"
  lede="Jogue Campo Minado diretamente no navegador sem instalar nada: o tabuleiro completo está logo abaixo, pronto para o primeiro clique."
  faq={faq}
  cta={{ href: '/pt/', label: 'Abrir em tela cheia', text: 'Quer o tabuleiro completo com gráfico de replay? Abra o jogo principal em uma nova aba.' }}
>
  <h2>Campo Minado direto no navegador</h2>
  <ul>
    <li><strong>Zero instalação</strong>: abre rápido em qualquer navegador moderno no PC, Mac, Chromebook ou celular.</li>
    <li><strong>Amigável para trackpad e toque</strong>: toque longo para bandeira e duplo clique para abertura em cadeia sem botão direito.</li>
    <li><strong>Modo Aprendizado integrado</strong>: ative o mapa de calor de probabilidades em tempo real e veja sua eficiência de decisão ao final.</li>
  </ul>

  <h2>Jogar Campo Minado agora</h2>
  <iframe
    class="play-iframe"
    src="/pt/"
    title="Meathill Minesweeper - Campo Minado online grátis"
  ></iframe>
  <p class="text-sm opacity-60">Tabuleiro real acima: clique esquerdo abre, clique direito ou toque longo marca bandeira, duplo clique abre em cadeia.</p>

  <h2>Quer aprender os truques?</h2>
  <p>
    Veja nosso guia completo de <a href="/pt/guide/how-to-play/">como jogar Campo Minado</a> ou compare os controles com o <a href="/pt/guide/google-minesweeper/">Campo Minado do Google</a>. Em redes escolares ou corporativas, respeite sempre as políticas locais de acesso.
  </p>
</GuideLayout>
<style>
  .play-iframe {
    display: block;
    width: 100%;
    height: clamp(480px, 72vh, 760px);
    border: 1px solid var(--meathill-rule-strong);
    border-radius: var(--meathill-radius-large);
    background: var(--meathill-paper);
  }
</style>

