---
import GuideLayout from '../../layouts/GuideLayout.astro';
import Calculator from '../../components/Calculator.astro';
import type { FaqItem } from '../../types';

const faq: FaqItem[] = [
  {
    question: '扫雷概率计算器算得准吗？',
    answer:
      '前沿区域（数字周围的未翻开格）用约束精确枚举，结果是准确的数学概率；孤立区域按剩余雷数均摊。极大的分量会先判断必雷/必安全格，其余近似计算并在页面上标注。',
  },
  {
    question: '它和游戏里的学习模式有什么区别？',
    answer:
      '学习模式在对局中实时更新，并给每次决策打分、支持局后复盘；计算器是静态分析工具，适合还原任意盘面——包括复盘自己的败局或对照别人的局面，两者用的是同一个求解器。',
  },
  {
    question: '支持多大的棋盘？',
    answer:
      '内置简单 9×9·10、中等 16×16·40、困难 16×30·99 三档预设，行列与总雷数都可以自定义；单个约束分量超过 28 格时自动转为近似以保证速度。',
  },
  {
    question: '插旗会影响计算吗？',
    answer:
      '默认会。勾选「将 🚩 计为已知雷」时，计算器会把已插旗的格子视为确定雷（100%），自动从相邻数字约束与剩余总雷数中扣除，方便推演残局；如果你不确定某面旗是否插错，取消勾选即可切换为验算模式，求解器会忽略所有旗并直接在旗旁给出真实概率。',
  },
];
---

<GuideLayout
  lang="zh"
  title="扫雷概率计算器 - 精确计算每格是雷的概率 - 肉山扫雷"
  heading="扫雷概率计算器"
  description="免费在线扫雷概率计算器：还原任意盘面，精确枚举每个未翻开格是雷的概率。与肉山扫雷游戏内学习模式使用同一个求解器，支持自定义棋盘与雷数，支持标旗扣减与错旗验算双模式。点格子还原数字与空白格，概率绿低红高，适合复盘败局或推演残局，大盘面自动标出必雷与必安全格。"
  path="/tools/probability-calculator/"
  keywords="扫雷概率计算器,扫雷计算器,扫雷求解器,扫雷概率,minesweeper probability calculator"
  updated="2026-10-30"
  lede="把当前局面还原到棋盘上（点击标记 🚩、空白 0 格与数字 1–8），计算器会精确算出每个未翻开格是雷的概率——用的正是肉山扫雷游戏内学习模式的同一个求解器。"
  faq={faq}
>
  <Calculator lang="zh" />

  <h2>怎么使用扫雷概率计算器？</h2>
  <ol>
    <li>从难度下拉框选择简单、中等、困难预设，或自定义行、列与总雷数。</li>
    <li><strong>点击格子循环状态</strong>：未翻开 → 🚩 → 空白(0) → 数字 1–8；右键反向循环（聚焦格子后也可直接按键盘 <code>0–8</code> 或 <code>F</code> 快速录入）。</li>
    <li>每个未翻开格都会实时显示是雷的概率（%），绿低红高。默认将 🚩 计为已知雷并扣减剩余雷数；若想检验自己的标旗是否标错，取消勾选「将 🚩 计为已知雷」即可。</li>
    <li>卡住时，选百分比最低的格子出手——这就是期望收益最高的决策。</li>
  </ol>

  <h2>概率是怎么算出来的？</h2>
  <p>
    每个已翻开的数字（含空白 0 格）都是一条约束：「我周围的未知格里恰好有对应数量的雷」（开启已知雷模式时自动扣除相邻 🚩）。计算器把相连的约束拆成独立分量，
    对每个分量做<strong>带剪枝的精确枚举</strong>，统计每格在所有合法布雷方案中出现雷的频率，得到精确概率；
    与任何约束都不相邻的孤立格，按剩余雷数均摊。单个分量超过 28 格时转为「必雷/必安全判定 + 近似」，并在页面上标注。
  </p>

  <h2>什么时候用它？</h2>
  <ul>
    <li><strong>两难局面</strong>：直觉说「差不多」，数字会说 30% 和 70% 的差别。</li>
    <li><strong>复盘败局</strong>：还原当时的盘面，看看那一步到底该不该点。</li>
    <li><strong>验证直觉</strong>：对照游戏内学习模式的热力图，训练自己的概率感。</li>
  </ul>
</GuideLayout>
