---
import GuideLayout from '../../layouts/GuideLayout.astro';
import Calculator from '../../components/Calculator.astro';
import type { FaqItem } from '../../types';

const faq: FaqItem[] = [
  {
    question: '扫雷概率计算器算得准吗？',
    answer:
      '前沿区域（数字周围的未翻开格）用约束精确枚举，结果是准确的数学概率；孤立区域按剩余雷数均摊。极大的分量会先判断必雷/必安全格，其余近似计算并在页面上标注。',
  },
  {
    question: '它和游戏里的学习模式有什么区别？',
    answer:
      '学习模式在对局中实时更新，并给每次决策打分、支持局后复盘；计算器是静态分析工具，适合还原任意盘面——包括复盘自己的败局或对照别人的局面，两者用的是同一个求解器。',
  },
  {
    question: '支持多大的棋盘？',
    answer:
      '内置简单 9×9·10、中等 16×16·40、困难 16×30·99 三档预设，行列与总雷数都可以自定义；单个约束分量超过 28 格时自动转为近似以保证速度。',
  },
  {
    question: '为什么有的格子没有显示百分比？',
    answer:
      '通常是局面非法，例如已标雷数超过了总雷数；状态栏会给出红色提示，修正后立即恢复计算。',
  },
];
---

<GuideLayout
  lang="zh"
  title="扫雷概率计算器 - 精确计算每格是雷的概率 - 肉山扫雷"
  heading="扫雷概率计算器"
  description="免费在线扫雷概率计算器：还原任意盘面，精确枚举每个未翻开格是雷的概率。与肉山扫雷游戏内学习模式使用同一个求解器，支持自定义棋盘与雷数。"
  path="/tools/probability-calculator/"
  keywords="扫雷概率计算器,扫雷计算器,扫雷求解器,扫雷概率,minesweeper probability calculator"
  updated="2026-09-03"
  lede="把当前局面还原到棋盘上（点击标记数字与已知雷），计算器会精确算出每个未翻开格是雷的概率——用的正是肉山扫雷游戏内学习模式的那个求解器。"
  faq={faq}
>
  <Calculator lang="zh" />

  <h2>怎么使用扫雷概率计算器？</h2>
  <ol>
    <li>选择难度预设，或自定义行、列与总雷数。</li>
    <li><strong>点击格子循环状态</strong>：未翻开 → 🚩（已知雷）→ 数字 1–8；右键反向循环，把局面还原成你看到的样子。</li>
    <li>每个未翻开格上实时显示是雷的概率（%），绿低红高；「剩余雷数」会自动扣除已标雷。</li>
    <li>卡住时，选百分比最低的格子出手——这就是期望收益最高的决策。</li>
  </ol>

  <h2>概率是怎么算出来的？</h2>
  <p>
    每个已翻开的数字都是一条约束：「我周围的未翻开格里恰好有 (数字 − 已插旗) 颗雷」。计算器把这些约束按关联关系拆成独立分量，
    对每个分量做<strong>带剪枝的精确枚举</strong>，统计每格在所有合法布雷方案中出现雷的频率，得到精确概率；
    与任何约束都不相邻的孤立格，按剩余雷数均摊。单个分量超过 28 格时转为「必雷/必安全判定 + 近似」，并在页面上标注。
  </p>

  <h2>什么时候用它？</h2>
  <ul>
    <li><strong>两难局面</strong>：直觉说「差不多」，数字会说 30% 和 70% 的差别。</li>
    <li><strong>复盘败局</strong>：还原当时的盘面，看看那一步到底该不该点。</li>
    <li><strong>验证直觉</strong>：对照游戏内学习模式的热力图，训练自己的概率感。</li>
  </ul>
</GuideLayout>
