---
import GuideLayout from '../../layouts/GuideLayout.astro';
import type { FaqItem } from '../../types';

const faq: FaqItem[] = [
  {
    question: 'Faut-il télécharger un logiciel pour jouer ?',
    answer:
      'Non. Le jeu complet tourne directement dans cette page web — sans installation, sans inscription et sans extension.',
  },
  {
    question: 'Que se passe-t-il si ma connexion coupe en pleine partie ?',
    answer:
      'Une fois la page chargée, toute la logique s’exécute localement sur votre appareil. Une micro-coupure réseau n’interrompt pas votre grille en cours.',
  },
  {
    question: 'Comment poser un drapeau sur téléphone ou trackpad ?',
    answer:
      'Appui long sur mobile, tap à deux doigts sur trackpad. Dès que les drapeaux autour d’un chiffre correspondent à sa valeur, un double-clic ouvre toutes les cases voisines sûres.',
  },
  {
    question: 'Comment jouer en plein écran ?',
    answer:
      'Utilisez le bouton « Ouvrir en plein écran » ci-dessous pour ouvrir l’interface dédiée, ou appuyez sur F11 sur ordinateur.',
  },
];
---

<GuideLayout
  lang="fr"
  title="Démineur en Ligne Gratuit - Jouer dans le Navigateur Sans Téléchargement - Meathill Minesweeper"
  heading="Démineur en ligne — jouez instantanément"
  description="Jouez au Démineur gratuitement dans votre navigateur : sans téléchargement, sans compte, optimisé trackpad et mobile, avec trois niveaux et Mode Apprentissage."
  path="/unblocked/"
  keywords="démineur en ligne, jouer au démineur gratuit, démineur navigateur, démineur sans téléchargement, minesweeper unblocked"
  updated="2026-10-30"
  lede="Jouez au Démineur directement dans votre navigateur sans rien installer : la grille complète vous attend juste ci-dessous dès le premier clic."
  faq={faq}
  cta={{ href: '/fr/', label: 'Ouvrir en plein écran', text: 'Envie du grand plateau et du graphique de replay complet ? Ouvrez le jeu principal dans un nouvel onglet.' }}
>
  <h2>Démineur en ligne, zéro installation</h2>
  <ul>
    <li><strong>Aucun téléchargement</strong> : fonctionne immédiatement sur PC, Mac, Chromebook, iPhone et Android.</li>
    <li><strong>Conçu pour le tactile et le trackpad</strong> : appui long pour marquer une mine et double-clic pour ouvrir en chaîne sans clic droit.</li>
    <li><strong>Mode Apprentissage intégré</strong> : superposez la carte thermique des probabilités en direct et analysez vos décisions en fin de partie.</li>
  </ul>

  <h2>Jouer au Démineur maintenant</h2>
  <iframe
    class="play-iframe"
    src="/fr/"
    title="Meathill Minesweeper - Démineur en ligne gratuit"
  ></iframe>
  <p class="text-sm opacity-60">Grille interactive ci-dessus : clic gauche pour ouvrir, clic droit ou appui long pour poser un drapeau, double-clic pour ouvrir en chaîne.</p>

  <h2>Pour progresser encore plus vite</h2>
  <p>
    Parcourez notre guide pour savoir <a href="/fr/guide/how-to-play/">comment jouer au Démineur</a> ou comparez les raccourcis avec le <a href="/fr/guide/google-minesweeper/">Démineur Google</a>. Sur un réseau scolaire ou d’entreprise, respectez toujours les règles d’utilisation en vigueur.
  </p>
</GuideLayout>
<style>
  .play-iframe {
    display: block;
    width: 100%;
    height: clamp(480px, 72vh, 760px);
    border: 1px solid var(--meathill-rule-strong);
    border-radius: var(--meathill-radius-large);
    background: var(--meathill-paper);
  }
</style>

