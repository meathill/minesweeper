---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import Calculator from '../../../components/Calculator.astro';
import type { FaqItem } from '../../../types';

const faq: FaqItem[] = [
  {
    question:
      'Quelle est la précision du calculateur de probabilité Démineur ?',
    answer:
      'Les cases frontalières (adjacentes aux chiffres ouverts) sont calculées par énumération exacte de toutes les configurations valides de mines. Les cases isolées se partagent équitablement les mines restantes.',
  },
  {
    question: 'Quelle différence avec le Mode Apprentissage du jeu ?',
    answer:
      'Le Mode Apprentissage tourne en temps réel pendant vos parties et note chaque décision. Ce calculateur analyse une position fixe — idéal pour étudier une défaite ou une grille du Démineur Google.',
  },
  {
    question: 'Quelles tailles de grille sont prises en charge ?',
    answer:
      'Trois formats classiques (Facile 9×9·10, Moyen 16×16·40, Difficile 16×30·99) ainsi que des lignes, colonnes et nombres de mines personnalisés.',
  },
  {
    question: 'Les drapeaux modifient-ils les probabilités calculées ?',
    answer:
      'Non. Comme un drapeau posé par le joueur peut être erroné, le solveur s’appuie uniquement sur les chiffres ouverts et le total de mines pour garantir un calcul incorruptible.',
  },
];
---

<GuideLayout
  lang="fr"
  title="Calculateur de Probabilité Démineur - Solveur Exact en Ligne - Meathill Minesweeper"
  heading="Calculateur de probabilité Démineur"
  description="Calculateur et solveur gratuit de Démineur : reproduisez n’importe quelle grille et obtenez la probabilité exacte de mine sur chaque case fermée."
  path="/tools/probability-calculator/"
  keywords="calculateur démineur, solveur démineur, probabilité démineur, aide démineur en ligne"
  updated="2026-10-30"
  lede="Reproduisez votre position en cliquant sur les cases pour placer chiffres et drapeaux : le solveur affiche aussitôt la probabilité exacte (%) de mine sur chaque case fermée."
  faq={faq}
>
  <Calculator lang="fr" />

  <h2>Comment utiliser le calculateur</h2>
  <ol>
    <li>Choisissez un préréglage (Facile, Moyen, Difficile) ou saisissez vos dimensions et le nombre total de mines.</li>
    <li><strong>Cliquez sur les cases pour faire défiler</strong> : fermée → 🚩 → chiffres 1–8 (clic droit pour revenir en arrière) jusqu’à recréer votre plateau.</li>
    <li>Consultez le pourcentage affiché sur chaque case cachée (vert = risque faible, rouge = forte probabilité de mine) et jouez le coup optimal.</li>
  </ol>

  <h2>Comment fonctionne le solveur</h2>
  <p>
    Chaque chiffre ouvert impose une équation exacte sur ses 8 voisines. Le moteur découpe la frontière en composantes indépendantes et énumère toutes les répartitions valides par élagage, exactement comme dans le <a href="/fr/">Mode Apprentissage de Meathill Minesweeper</a>. Débutant ? Découvrez d’abord <a href="/fr/guide/how-to-play/">comment jouer au Démineur</a> ou nos astuces sur le <a href="/fr/guide/google-minesweeper/">Démineur Google</a>.
  </p>
</GuideLayout>
