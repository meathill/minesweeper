---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import type { FaqItem, HowToData } from '../../../types';

const faq: FaqItem[] = [
  {
    question:
      'Cắm cờ trong Dò Mìn Google trên máy tính và điện thoại như thế nào?',
    answer:
      'Trên máy tính có chuột, bấm chuột phải vào ô chưa mở. Trên touchpad laptop không có chuột, chạm cùng lúc hai ngón tay (hoặc giữ Control + bấm trên MacBook / Alt + bấm trên Chromebook). Trên điện thoại hoặc máy tính bảng, nhấn giữ vào ô hoặc bấm biểu tượng cờ 🚩 ở thanh dưới.',
  },
  {
    question: 'Mở trò chơi Dò Mìn Google miễn phí ở đâu?',
    answer:
      'Mở Google Tìm kiếm, gõ «dò mìn», «dò mìn google» hoặc «minesweeper» rồi bấm nút màu xanh «Chơi» ngay phía trên kết quả tìm kiếm. Không cần tải ứng dụng hay đăng nhập.',
  },
  {
    question: 'Chơi Dò Mìn Google không có mạng (offline) được không?',
    answer:
      'Trò chơi tích hợp trong Google cần kết nối mạng lần đầu để tải trang tìm kiếm. Tuy nhiên khi bàn chơi đã hiển thị trong tab trình duyệt — hoặc khi chơi trên trang web chạy cục bộ như Meathill Minesweeper — bạn vẫn chơi hết ván hiện tại dù mất Wi-Fi.',
  },
  {
    question: 'Dò Mìn Google có phím tắt Spacebar để cắm cờ không?',
    answer:
      'Không. Khác với một số trang game chuyên biệt, bản Dò Mìn chính thức của Google không hỗ trợ phím cách (bấm Space sẽ làm cuộn trang tìm kiếm xuống). Hãy dùng chạm 2 ngón trên touchpad hoặc nút 🚩 trên bàn chơi.',
  },
  {
    question: 'Các mức độ khó của Dò Mìn Google gồm những gì?',
    answer:
      'Có 3 mức: Dễ (10×8 · 10 mìn), Vừa (18×14 · 40 mìn) và Khó (24×20 · 99 mìn). Nếu muốn chơi bàn chuẩn quốc tế (9×9, 16×16 và 16×30) kèm thống kê và gợi ý xác suất, hãy mở Meathill Minesweeper.',
  },
];

const howTo: HowToData = {
  name: 'Cách mở và chơi Dò Mìn Google miễn phí',
  steps: [
    'Truy cập Google và gõ «dò mìn» hoặc «dò mìn google» vào thanh tìm kiếm.',
    'Bấm nút «Chơi» màu xanh trong khung trò chơi hiện ngay đầu trang kết quả.',
    'Chọn độ khó (Dễ, Vừa hoặc Khó) rồi bấm vào một ô bất kỳ — nước đi đầu tiên luôn an toàn.',
    'Đọc con số để đếm mìn trong 8 ô kề bên, cắm cờ đánh dấu mìn và mở toàn bộ ô an toàn để chiến thắng.',
  ],
};
---

<GuideLayout
  lang="vi"
  title="Dò Mìn Google: Cách Chơi Miễn Phí, Cắm Cờ Không Chuột & Mẹo (2026)"
  heading="Dò Mìn Google: cách chơi miễn phí, cắm cờ và mẹo thắng nhanh"
  description="Hướng dẫn chơi Dò Mìn Google (2026): cách mở nhanh trên thanh tìm kiếm, cắm cờ trên PC, laptop không chuột và điện thoại, các cấp độ và mẹo phá đảo."
  path="/guide/google-minesweeper/"
  keywords="dò mìn google, trò chơi dò mìn trên google, dò mìn online, cách cắm cờ dò mìn google, dò mìn không cần chuột"
  updated="2026-10-30"
  lede="Muốn vào ván ngay lập tức? Bấm ô bất kỳ trên bàn 9×9 ngay bên dưới để chơi liền tay (tích hợp sẵn nút chuyển 🚩 Cắm cờ), hoặc xem chi tiết cách mở và điều khiển Dò Mìn trên Google ở mọi thiết bị."
  faq={faq}
  howTo={howTo}
>
  <p>
    <strong>Dò Mìn Google</strong> (Google Minesweeper) là trò chơi giải đố kinh điển miễn phí được tích hợp sẵn ngay trên trang kết quả Google Tìm kiếm: chỉ cần gõ «dò mìn» và bấm Chơi để mở bàn cờ trực tiếp trên máy tính hoặc điện thoại với ba cấp độ (Dễ, Vừa và Khó) mà không cần tải về.
  </p>

  <h2>Cách mở và chơi Dò Mìn Google từng bước</h2>
  <ol>
    <li>Mở trình duyệt, vào Google và nhập <strong>«dò mìn»</strong> hoặc <strong>«dò mìn google»</strong>.</li>
    <li>Nhấn nút màu xanh <strong>«Chơi»</strong> trong thẻ Doodle tương tác phía trên cùng kết quả tìm kiếm.</li>
    <li>Chọn cấp độ ở góc trên bên trái (<strong>Dễ</strong>, <strong>Vừa</strong> hoặc <strong>Khó</strong>) và bấm vào bất kỳ ô xanh nào — <strong>lượt bấm đầu tiên không bao giờ trúng mìn</strong>.</li>
    <li>Dựa vào các con số (mỗi số chỉ tổng số mìn trong 8 ô xung quanh) để cắm cờ 🚩 và mở sạch các ô không có mìn.</li>
  </ol>

  <h2>Cách cắm cờ trên PC, laptop không có chuột và điện thoại</h2>
  <p>
    Lưu ý quan trọng cho người dùng laptop: <strong>Dò Mìn Google không hỗ trợ phím Spacebar để cắm cờ</strong> (nhấn phím cách sẽ cuộn trang tìm kiếm xuống). Dưới đây là thao tác chuẩn cho từng thiết bị:
  </p>

  <div
    tabindex="0"
    role="region"
    aria-labelledby="vi-controls-caption"
    class="guide-table-wrapper not-prose"
    style="--col-2: 'Mở ô'; --col-3: 'Cắm / gỡ cờ 🚩';"
  >
    <table>
      <caption id="vi-controls-caption">Bảng thao tác Dò Mìn Google trên từng thiết bị</caption>
      <thead>
        <tr>
          <th>Thiết bị</th>
          <th>Mở ô</th>
          <th>Cắm / gỡ cờ 🚩</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>PC / Mac dùng chuột rời</th>
          <td>Chuột trái</td>
          <td>Chuột phải vào ô chưa mở</td>
        </tr>
        <tr>
          <th>MacBook (Trackpad)</th>
          <td>Chạm 1 ngón</td>
          <td>Chạm 2 ngón cùng lúc hoặc <code>Control + bấm</code></td>
        </tr>
        <tr>
          <th>Laptop Windows (Touchpad)</th>
          <td>Chạm 1 ngón</td>
          <td>Chạm 2 ngón hoặc nhấn góc dưới bên phải</td>
        </tr>
        <tr>
          <th>Chromebook</th>
          <td>Chạm 1 ngón</td>
          <td>Chạm 2 ngón hoặc giữ <code>Alt + bấm</code></td>
        </tr>
        <tr>
          <th>Điện thoại &amp; Máy tính bảng</th>
          <td>Chạm nhẹ</td>
          <td>Nhấn giữ ô hoặc bấm biểu tượng 🚩 / ⛏️ ở thanh dưới</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Thấy chạm hai ngón trên touchpad chậm tay? Chuyển sang <a href="/vi/">Meathill Minesweeper</a> hoặc trang <a href="/vi/unblocked/">chơi Dò Mìn online</a> của chúng tôi: khi số cờ quanh một con số đã đủ, <strong>nháy đúp vào con số đó sẽ mở toàn bộ các ô kề an toàn cùng lúc</strong> mà không cần chuột phải.
  </p>

  <h2>Điểm hạn chế của bản Google &amp; cách luyện lên cao thủ</h2>
  <ul>
    <li><strong>Không có gợi ý xác suất</strong>: gặp thế cờ 50/50 cuối ván bạn chỉ biết đoán mò, dù thực tế có ô chỉ 20% rủi ro so với 70%.</li>
    <li><strong>Không xem lại được ván thua</strong>: dẫm trúng mìn là kết thúc, không thể tua lại bước đi sai lầm.</li>
    <li><strong>Kích thước bàn lệch chuẩn cổ điển</strong>: Google dùng lưới 10×8, 18×14 và 24×20 thay vì chuẩn 9×9, 16×16 và 16×30.</li>
  </ul>
  <p>
    Muốn biến đoán mò thành tính toán logic? Luyện ngay các mẫu cơ bản tại bài <a href="/vi/guide/how-to-play/">cách chơi Dò Mìn và mô hình 1-2-1</a>, dựng lại thế cờ khó bằng <a href="/vi/tools/probability-calculator/">Máy tính xác suất Dò Mìn</a>, hoặc bật <strong>Chế độ học</strong> trên <a href="/vi/">Meathill Minesweeper</a>!
  </p>
</GuideLayout>
